          "request": {
            "name": "BigCommerce Create a Token",
            "description": {
              "content": "Returns a Storefront API token that allows your application to impersonate customers when making GraphQL `POST` requests. For more information on how to use the returned token, see [customer impersonation tokens](/docs/rest-authentication/tokens/customer-impersonation-token#create-a-token).\n\n**Required Scopes**\n* `Manage` `Storefront API Customer Impersonation Tokens`",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "storefront",
                "api-token-customer-impersonation"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "Permanent ID of the BigCommerce store.",
                  "type": "any",
                  "value": "{{store_hash}}",
                  "key": "store_hash"
                }
              ]
            },
