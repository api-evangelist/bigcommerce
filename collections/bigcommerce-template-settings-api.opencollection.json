{
  "opencollection": "1.0.0",
  "info": {
    "name": "BigCommerce Abandoned Cart Emails Template Settings API",
    "version": "3.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Auth-Token",
      "value": "{{X-Auth-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Template Settings",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "BigCommerce Get email template settings",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.bigcommerce.com/stores/{store_hash}/v3/marketing/abandoned-cart-emails/settings",
            "headers": [
              {
                "name": "Accept",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "channel_id",
                "value": "",
                "type": "query",
                "description": "Channel ID to use for channel-specific setting."
              }
            ]
          },
          "docs": "Read Abandoned Cart Email Template settings."
        },
        {
          "info": {
            "name": "BigCommerce Update email template settings",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.bigcommerce.com/stores/{store_hash}/v3/marketing/abandoned-cart-emails/settings",
            "headers": [
              {
                "name": "Accept",
                "value": ""
              },
              {
                "name": "Content-Type",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "channel_id",
                "value": "",
                "type": "query",
                "description": "Channel ID to use for channel-level data."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update Abandoned Cart Email template settings."
        }
      ]
    }
  ],
  "bundled": true
}