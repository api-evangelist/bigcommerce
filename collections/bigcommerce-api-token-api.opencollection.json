{
  "opencollection": "1.0.0",
  "info": {
    "name": "BigCommerce Abandoned Cart Emails API Token API",
    "version": "3.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Auth-Token",
      "value": "{{X-Auth-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "API Token",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "BigCommerce Create a Token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.bigcommerce.com/stores/{store_hash}/v3/storefront/api-token",
            "headers": [
              {
                "name": "Accept",
                "value": ""
              },
              {
                "name": "Content-Type",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a Storefront API token.\n\n**Required Scopes**\n* `Manage` `Storefront API Tokens`"
        },
        {
          "info": {
            "name": "BigCommerce Revoke a Token",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.bigcommerce.com/stores/{store_hash}/v3/storefront/api-token",
            "headers": [
              {
                "name": "Accept",
                "value": ""
              },
              {
                "name": "Sf-Api-Token",
                "value": ""
              }
            ]
          },
          "docs": "Revoke access for a Storefront API token. Only revoke compromised tokens under emergency situations. Let uncompromised short-lived tokens expire naturally, as you do not need to revoke these."
        }
      ]
    }
  ],
  "bundled": true
}