          "id": "2cabb438-b813-4dcb-baeb-fcd3c5ab0b2a",
          "name": "BigCommerce Create an Order",
          "request": {
            "name": "BigCommerce Create an Order",
            "description": {
              "content": "Creates an order.\n\n## Usage notes\n* Orders created will be set to incomplete order status.\n* You can create as many orders from the same order (cart) as you want.\n* Order duplication copies the existing order, assigns a new order number, and sets the new order status to `incomplete`.\n* Once the order is paid, the cart is deleted.\n* Cart deletion occurs if you are using BigCommerce to accept payments on orders.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "checkouts",
                ":checkoutId",
                "orders"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "checkoutId",
                  "description": "(Required) ID of the checkout; the same as the cart ID."
                },
                {
                  "description": "Permanent ID of the BigCommerce store.",
                  "type": "any",
                  "value": "{{store_hash}}",
                  "key": "store_hash"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null
          },
