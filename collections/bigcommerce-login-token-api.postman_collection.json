          "request": {
            "name": "BigCommerce Login Token",
            "description": {
              "content": "The customer login access point URL.\n\n[Learn more about the Customer Login API](/docs/start/authentication/customer-login).\n\n## Example\n\n```\nhttps://yourstore.example.com/login/token/eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJ7Y2xpZW50X2lkfSIsImlhdCI6MTUzNTM5MzExMywianRpIjoie3V1aWR9Iiwib3BlcmF0aW9uIjoiY3VzdG9tZXJfbG9naW4iLCJzdG9yZV9oYXNoIjoie3N0b3JlX2hhc2h9IiwiY3VzdG9tZXJfaWQiOjJ9.J-fAtbjRFGdLsT744DhoprFEDqIfVq72HbDzrbFy6Is\n```",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "login",
                "token",
                ":jwt_token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "jwt_token",
                  "description": "(Required) "
                },
                {
                  "description": "Permanent ID of the BigCommerce store.",
                  "type": "any",
                  "value": "{{store_hash}}",
                  "key": "store_hash"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "*/*"
              }
            ],
            "method": "GET",
            "auth": null
          },
