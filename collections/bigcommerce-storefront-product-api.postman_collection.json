            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "PUT",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"show_product_price\": \"<boolean>\",\n  \"show_product_sku\": \"<boolean>\",\n  \"show_product_weight\": \"<boolean>\",\n  \"show_product_brand\": \"<boolean>\",\n  \"show_product_shipping\": \"<boolean>\",\n  \"show_product_rating\": \"<boolean>\",\n  \"show_add_to_cart_link\": \"<boolean>\",\n  \"default_preorder_message\": \"<string>\",\n  \"show_breadcrumbs_product_pages\": \"<string>\",\n  \"show_add_to_cart_qty_box\": \"<boolean>\",\n  \"show_add_to_wishlist\": \"<boolean>\",\n  \"hide_price_from_guests\": \"<boolean>\"\n}",
