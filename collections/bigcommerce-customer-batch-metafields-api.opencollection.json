{
  "opencollection": "1.0.0",
  "info": {
    "name": "BigCommerce Abandoned Cart Emails Customer Batch Metafields API",
    "version": "3.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Auth-Token",
      "value": "{{X-Auth-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Customer Batch Metafields",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "BigCommerce Get All Customer Metafields",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.bigcommerce.com/stores/{store_hash}/v3/customers/metafields",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Specifies the page number in a limited (paginated) list of products.\n"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Controls the number of items per page in a limited (paginated) list of products.\n"
              },
              {
                "name": "key",
                "value": "",
                "type": "query",
                "description": "Filter based on a metafieldʼs key."
              },
              {
                "name": "key:in",
                "value": "",
                "type": "query",
                "description": "Filter based on comma-separated metafieldʼs keys. Could be used with vanilla 'key' query parameter."
              },
              {
                "name": "namespace",
                "value": "",
                "type": "query",
                "description": "Filter based on a metafieldʼs namespaces."
              },
              {
                "name": "namespace:in",
                "value": "",
                "type": "query",
                "description": "Filter based on comma-separated metafieldʼs namespaces. Could be used with vanilla `namespace` query parameter."
              },
              {
                "name": "direction",
                "value": "",
                "type": "query",
                "description": "Sort direction. Acceptable values are: `asc`, `desc`.\n"
              }
            ]
          },
          "docs": "Get all customer metafields."
        },
        {
          "info": {
            "name": "BigCommerce Create Multiple Metafields",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.bigcommerce.com/stores/{store_hash}/v3/customers/metafields",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create multiple metafields."
        },
        {
          "info": {
            "name": "BigCommerce Update Multiple Metafields",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.bigcommerce.com/stores/{store_hash}/v3/customers/metafields",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create multiple metafields."
        },
        {
          "info": {
            "name": "BigCommerce Delete All Metafields",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.bigcommerce.com/stores/{store_hash}/v3/customers/metafields",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Delete all customer metafields."
