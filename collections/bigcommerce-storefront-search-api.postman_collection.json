          "id": "1e7115bd-803a-4f39-8445-798fc421dd66",
          "name": "BigCommerce Get Storefront Search Settings",
          "request": {
            "name": "BigCommerce Get Storefront Search Settings",
            "description": {
              "content": "Returns search settings.\n\n - Channel ID can be used as a query parameter for getting channel-specific setting. If omitted, you will interact with the global setting only. \n\n - `null` indicates that a particular field has not been overridden on a channel level when channel level settings are requested and values are inherited from global level.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "settings",
                "storefront",
                "search"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "channel_id",
                  "value": "<integer>",
                  "description": "Channel ID to use for channel-specific setting. If omitted, you will interact with the global setting only."
                }
              ],
              "variable": [
                {
                  "description": "Permanent ID of the BigCommerce store.",
                  "type": "any",
                  "value": "{{store_hash}}",
                  "key": "store_hash"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
