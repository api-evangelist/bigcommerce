          "id": "6bd73254-8643-403a-b67f-601f0a4371d0",
          "name": "BigCommerce Revoke a Token",
          "request": {
            "name": "BigCommerce Revoke a Token",
            "description": {
              "content": "Revoke access for a Storefront API token. Only revoke compromised tokens under emergency situations. Let uncompromised short-lived tokens expire naturally, as you do not need to revoke these.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "storefront",
                "api-token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "Permanent ID of the BigCommerce store.",
                  "type": "any",
                  "value": "{{store_hash}}",
                  "key": "store_hash"
                }
              ]
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) An existing JWT token that you want to revoke.",
                "key": "Sf-Api-Token",
                "value": "<string>"
              }
            ],
            "method": "DELETE",
            "auth": null
