          "name": "BigCommerce Get an Abandoned Cart",
          "request": {
            "name": "BigCommerce Get an Abandoned Cart",
            "description": {
              "content": "Returns the `cart_id` corresponding to the abandoned cart `{token}` passed in.\n\n**Usage Notes**:\n* `{token}` is the token in the query string of the abandoned cart link found in abandoned cart email notifications to shoppers",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "abandoned-carts",
                ":token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "token",
                  "description": "(Required) Unique cart `UUID`.\n\nUnique cart `UUID` token that is generated for abandoned cart emails."
                },
                {
                  "description": "Permanent ID of the BigCommerce store.",
                  "type": "any",
                  "value": "{{store_hash}}",
                  "key": "store_hash"
                }
              ]
            },
