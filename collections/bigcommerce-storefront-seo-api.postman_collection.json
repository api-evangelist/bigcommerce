          "id": "667fba7c-bbde-482c-95f9-8747fc190d86",
          "name": "BigCommerce Update Storefront SEO Settings",
          "request": {
            "name": "BigCommerce Update Storefront SEO Settings",
            "description": {
              "content": "Updates SEO settings.\n\n - Channel ID can be used as a query parameter for updating channel-specific setting. If omitted, you will interact with the global setting only. \n\n - `null` should be supplied to delete overrides per given channel and to inherit values from global level. Partial updates are not supported and all settings should be supplied with `null` value in order to delete overrides per channel.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "settings",
                "storefront",
                "seo"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "channel_id",
                  "value": "<integer>",
                  "description": "Channel ID to use for channel-specific setting. If omitted, you will interact with the global setting only."
                }
              ],
              "variable": [
                {
                  "description": "Permanent ID of the BigCommerce store.",
                  "type": "any",
                  "value": "{{store_hash}}",
                  "key": "store_hash"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
