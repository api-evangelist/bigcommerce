          "id": "5695b76a-4238-475d-98c4-187c2738658d",
          "name": "BigCommerce Upsert Category Trees",
          "request": {
            "name": "BigCommerce Upsert Category Trees",
            "description": {
              "content": "Upserts *Category Trees*. \n\nThis single endpoint updates and creates category trees. If a tree object contains an ID, it is processed as an update operation using that ID. If you do not provide an ID, a new tree is created. The category tree `name` field is required to create trees, but is not required on the update.\n\n**Usage Notes**\n* `channel_id` is required to create a *Category Tree*. You can assign one `channel_id` to one category tree.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "catalog",
                "trees"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "Permanent ID of the BigCommerce store.",
                  "type": "any",
                  "value": "{{store_hash}}",
                  "key": "store_hash"
                }
