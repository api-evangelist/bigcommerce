          "name": "BigCommerce Delete Customs Information",
          "request": {
            "name": "BigCommerce Delete Customs Information",
            "description": {
              "content": "Deletes customs information objects for a product.\n\n## Example\n\nThis is a batch operation. The `product_id:in` query parameter is required.\n\n```http\nDELETE /shipping/products/customs-information?product_id:in=4,5,6\n```",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "shipping",
                "products",
                "customs-information"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "product_id:in",
                  "value": "<string>",
                  "description": "(Required) "
