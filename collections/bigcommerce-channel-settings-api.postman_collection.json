        {
          "id": "58f18cc4-98c1-4f6c-960e-4d1d5c8df24e",
          "name": "BigCommerce Update Customer Settings per Channel",
          "request": {
            "name": "BigCommerce Update Customer Settings per Channel",
            "description": {
              "content": "Update the customer settings per channel\n\n**Required Fields**\n\n* `channel_id`: Provide a `channel_id` array containing one or more channel IDs. Customers will have access to these channels and no others. This array cannot be empty.\n\n**Notes**\n\n* Setting `null` will delete override per given channel, and values will be inherited from the global level. Make sure the channel has `allow_global_logins` enabled.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "customers",
                "settings",
                "channels",
                ":channel_id"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "channel_id",
                  "description": "(Required) "
                },
                {
                  "description": "Permanent ID of the BigCommerce store.",
                  "type": "any",
                  "value": "{{store_hash}}",
                  "key": "store_hash"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "PUT",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"privacy_settings\": {\n    \"ask_shopper_for_tracking_consent\": \"<boolean>\",\n    \"policy_url\": \"<string>\"\n  },\n  \"customer_group_settings\": {\n    \"guest_customer_group_id\": \"<integer>\",\n    \"default_customer_group_id\": \"<integer>\"\n  },\n  \"allow_global_logins\": \"<boolean>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
