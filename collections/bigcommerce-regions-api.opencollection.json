{
  "opencollection": "1.0.0",
  "info": {
    "name": "BigCommerce Abandoned Cart Emails Regions API",
    "version": "3.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Auth-Token",
      "value": "{{X-Auth-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Regions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "BigCommerce Get Theme Regions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.bigcommerce.com/stores/{store_hash}/v3/content/regions",
            "headers": [
              {
                "name": "Accept",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "template_file",
                "value": "",
                "type": "query",
                "description": "The template file, for example: `templateFile=pages/home`."
              }
            ]
          },
          "docs": "Returns a list of unique **Theme Regions** in a file."
        }
      ]
    }
  ],
  "bundled": true
}