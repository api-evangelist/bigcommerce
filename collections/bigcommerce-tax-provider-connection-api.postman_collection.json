          "name": "BigCommerce Get Connection Status",
          "request": {
            "name": "BigCommerce Get Connection Status",
            "description": {
              "content": "Retrieve the connection status of the specified tax provider in the context of a store.\n\n> #### Note\n> * Requires **read** permissions on the **Information and Settings** scope.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "tax",
                "providers",
                ":provider_id",
                "connection"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "provider_id",
                  "description": "(Required) The Tax Providerʼs `provider_id` provided by BigCommerce after the provider [shares their provider details](/docs/integrations/tax#sharing-provider-details-with-bigcommerce)."
                },
                {
                  "description": "Permanent ID of the BigCommerce store.",
                  "type": "any",
                  "value": "{{store_hash}}",
                  "key": "store_hash"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
