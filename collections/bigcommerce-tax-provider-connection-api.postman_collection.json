        {
          "id": "5199ef37-dc91-4142-9460-cdd3a38058fd",
          "name": "BigCommerce Delete a Connection",
          "request": {
            "name": "BigCommerce Delete a Connection",
            "description": {
              "content": "Remove any previously set basic connection credentials for the specified provider. If the specified provider is the active tax provider on the store, the store's active tax provider will be reset to BigCommerce Manual Tax. It is suggested to call this endpoint during a single-click app [uninstall callback](/docs/integrations/apps/guide/callbacks#uninstall-callback).\n\n> #### Note\n> * This operation will be logged in [Store Logs](https://support.bigcommerce.com/s/article/Using-Store-Logs) under **Staff Actions**.\n> * Requires **write** permissions on the **Information and Settings** [scope](/docs/start/authentication/api-accounts#oauth-scopes).\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "tax",
