        {
          "id": "4cc7a3aa-fd2e-4cdb-bd96-abc37c18a140",
          "name": "BigCommerce Update a Connection",
          "request": {
            "name": "BigCommerce Update a Connection",
            "description": {
              "content": "Set authentication information associated with a merchant's account on the tax provider's infrastructure:\n- [HTTP Basic Authentication](https://developer.mozilla.org/en-US/docs/Web/HTTP/Authentication) (developer.mozilla.org) credentials\n- (optional) Tax provider profile used in customized endpoint urls for tax provider calls. This is only available for tax providers that support this feature.\n\nThe configured `username`, `password`, and `profile` (if available) is used to authenticate each API request to the Tax Provider from the associated store. \nThe tax provider's `profile` will be included in the url for [Tax Provider API](/docs/rest-contracts/tax) endpoints. \n\n> #### Note\n> * This operation will be logged in [Store Logs](https://support.bigcommerce.com/s/article/Using-Store-Logs) under **Staff Actions**.\n> * Requires **write** permissions on the **Information and Settings** [scope](/docs/start/authentication/api-accounts#oauth-scopes).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "tax",
                "providers",
                ":provider_id",
                "connection"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "provider_id",
                  "description": "(Required) The Tax Providerʼs `provider_id` provided by BigCommerce after the provider [shares their provider details](/docs/integrations/tax#sharing-provider-details-with-bigcommerce)."
                },
                {
                  "description": "Permanent ID of the BigCommerce store.",
                  "type": "any",
                  "value": "{{store_hash}}",
                  "key": "store_hash"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "PUT",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"<string>\",\n  \"password\": \"<string>\",\n  \"profile\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "81936048-282d-467e-8286-049af757962b",
              "name": "OK",
              "originalRequest": {
