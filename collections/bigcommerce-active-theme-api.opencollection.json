{
  "opencollection": "1.0.0",
  "info": {
    "name": "BigCommerce Abandoned Cart Emails Active Theme API",
    "version": "3.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Auth-Token",
      "value": "{{X-Auth-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Active Theme",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "BigCommerce Get a Channel Active Theme",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.bigcommerce.com/stores/{store_hash}/v3/channels/:channel_id/active-theme",
            "headers": [
              {
                "name": "Accept",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "channel_id",
                "value": "",
                "type": "path",
                "description": "The ID of a channel."
              }
            ]
          },
          "docs": "Returns details of the theme active on the specified channel.\nDoes not support active Blueprint (legacy) themes."
        }
      ]
    }
  ],
  "bundled": true
}