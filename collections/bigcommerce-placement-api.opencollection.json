              },
              {
                "name": "Content-Type",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "uuid",
                "value": "",
                "type": "path",
                "description": "The identifier for a specific placement."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
