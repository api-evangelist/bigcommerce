        },
        {
          "info": {
            "name": "BigCommerce Get a Placement",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.bigcommerce.com/stores/{store_hash}/v3/content/placements/:uuid",
            "headers": [
              {
                "name": "Accept",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "uuid",
                "value": "",
                "type": "path",
                "description": "The identifier for a specific placement."
              }
            ]
          },
