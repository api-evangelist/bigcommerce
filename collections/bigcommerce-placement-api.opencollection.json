              {
                "name": "site_id:in",
                "value": "",
                "type": "query",
                "description": "A comma-separated list of site IDs to filter the results by."
              }
            ]
          },
          "docs": "Returns a list of **Placements**."
        },
        {
          "info": {
            "name": "BigCommerce Create a Placement",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.bigcommerce.com/stores/{store_hash}/v3/content/placements",
            "headers": [
              {
                "name": "Accept",
                "value": ""
              },
              {
                "name": "Content-Type",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
