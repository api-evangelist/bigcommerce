{
  "opencollection": "1.0.0",
  "info": {
    "name": "BigCommerce Abandoned Cart Emails Site Checkout URL API",
    "version": "3.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Auth-Token",
      "value": "{{X-Auth-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Site Checkout URL",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "BigCommerce Upsert a Siteʼs Checkout URL",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.bigcommerce.com/stores/{store_hash}/v3/channels/:channel_id/site/checkout-url",
            "headers": [
              {
                "name": "Accept",
                "value": ""
              },
              {
                "name": "Content-Type",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "channel_id",
                "value": "",
                "type": "path",
                "description": "The ID of a channel."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates or updates (upserts) a siteʼs checkout URL"
        },
        {
          "info": {
            "name": "BigCommerce Delete a Siteʼs Checkout URL",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.bigcommerce.com/stores/{store_hash}/v3/channels/:channel_id/site/checkout-url",
            "headers": [
              {
                "name": "Accept",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "channel_id",
                "value": "",
                "type": "path",
                "description": "The ID of a channel."
              }
            ]
          },
          "docs": "Deletes a siteʼs checkout URL. After deletion, a shared checkout URL is used."
        }
      ]
    }
  ],
  "bundled": true
}